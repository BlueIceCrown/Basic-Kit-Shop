{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "allowJs": true,
        "checkJs": false,
        "verbatimModuleSyntax": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": false,
        "noImplicitOverride": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false,
        "rootDir": "./src",
        "outDir": "./scripts",
        "noEmitOnError": true,
        "sourceMap": false,
        "declaration": false
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js"
    ],
    "exclude": [
        "scripts",
        "node_modules",
        "eslint.config.mjs",
        "**/*.config.mjs"
    ]
}